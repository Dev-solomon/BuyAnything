# Core
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
BASE_URL=https://your-domain.com
FLASK_DEBUG=0

# OpenAI — product trend research + factual marketing copy
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Stripe — customer payment
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# CJdropshipping API 2.0 — supplier + fulfillment
# Keep this token server-side only. Never expose it in HTML/JavaScript.
CJ_ACCESS_TOKEN=replace-with-your-cj-access-token
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
CJ_FROM_COUNTRY=CN
CJ_LOGISTIC_NAME=CJPacket Ordinary
# 2 = pay CJ from your CJ balance when order is submitted after Stripe payment.
# Set 3 if you want CJ orders created but NOT automatically supplier-paid.
CJ_PAY_TYPE=2
